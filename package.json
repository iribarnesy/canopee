{
  "name": "canopee",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "l0:scene": "tsx scripts/l0-scene.ts",
    "l0:mesure": "node scripts/l0-mesure.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verif": "npm run typecheck && npm run lint && npm run check:boundaries && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
